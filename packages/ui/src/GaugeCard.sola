<script>
  export let title = "Utilization";
  export let value = "75%";
  export let percentage = 75;
  export let subtext = "";
  export let color = "emerald"; // emerald | sky | violet | amber | rose

  // Circumference for r=36 is 2 * PI * 36 ≈ 226.2
  const circumference = 226.2;
  let strokeDashoffset = $derived(() => circumference - (percentage / 100) * circumference);
  let resolvedSubtext = $derived(() => subtext || (percentage + "% Allocated Capacity"));

  const colorMap = {
    emerald: { stroke: "#10b981", ring: "rgba(16,185,129,0.16)" },
    sky:     { stroke: "#0ea5e9", ring: "rgba(14,165,233,0.16)" },
    violet:  { stroke: "#8b5cf6", ring: "rgba(139,92,246,0.16)" },
    amber:   { stroke: "#f59e0b", ring: "rgba(245,158,11,0.16)" },
    rose:    { stroke: "#f43f5e", ring: "rgba(244,63,94,0.16)" },
  };
  let activeColor = $derived(() => colorMap[color] || colorMap.emerald);
</script>

<div class="sola-gauge sola-gauge-{color}">
  <div class="gauge-header">
    <div class="gauge-title-wrap">
      <span class="gauge-dot"></span>
      <span class="gauge-title">{title}</span>
    </div>
    <span class="gauge-badge">Live Gauge</span>
  </div>

  <div class="gauge-body">
    <div>
      <div class="gauge-value">{value}</div>
      <div class="gauge-subtext">{resolvedSubtext()}</div>
    </div>

    <div class="gauge-ring-wrap">
      <svg class="gauge-ring" viewBox="0 0 88 88" preserveAspectRatio="xMidYMid meet">
        <circle cx="44" cy="44" r="36" stroke="var(--sola-surface-2, #f1f5f9)" stroke-width="7" fill="none" />
        <circle
          class="gauge-arc"
          cx="44" cy="44" r="36"
          stroke={activeColor().stroke}
          stroke-width="7"
          stroke-linecap="round"
          fill="none"
          stroke-dasharray={circumference}
          stroke-dashoffset={strokeDashoffset()}
        />
      </svg>
      <div class="gauge-pct">{percentage}%</div>
    </div>
  </div>

  <div class="gauge-footer">
    <span class="gauge-footer-left">
      <span class="gauge-footer-dot"></span>
      <span>Telemetry Synchronized</span>
    </span>
    <span class="gauge-footer-right">zero-vdom</span>
  </div>
</div>

<style>
  .sola-gauge {
    position: relative;
    background: var(--sola-surface-0, #ffffff);
    border: 1px solid var(--sola-border-subtle, #e2e8f0);
    border-radius: var(--sola-card-radius, 12px);
    padding: var(--sola-card-padding, 18px 20px);
    box-shadow: var(--sola-card-shadow, 0 1px 3px rgba(15, 23, 42, 0.04));
    transition: border-color var(--sola-duration-fast, 160ms) var(--sola-ease-standard, ease),
                box-shadow var(--sola-duration-fast, 160ms) var(--sola-ease-standard, ease);
    overflow: hidden;
  }

  .sola-gauge:hover { border-color: var(--sola-border-default, #cbd5e1); }

  .sola-gauge-emerald { --gauge-ring-color: #10b981; }
  .sola-gauge-sky { --gauge-ring-color: #0ea5e9; }
  .sola-gauge-violet { --gauge-ring-color: #8b5cf6; }
  .sola-gauge-amber { --gauge-ring-color: #f59e0b; }
  .sola-gauge-rose { --gauge-ring-color: #f43f5e; }

  .gauge-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .gauge-title-wrap { display: flex; align-items: center; gap: 8px; }

  .gauge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gauge-ring-color, #10b981); }

  .gauge-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--sola-text-secondary, #475569);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: ui-monospace, monospace;
  }

  .gauge-badge {
    font-size: 12px;
    font-weight: 600;
    background: var(--sola-surface-1, #f8fafc);
    border: 1px solid var(--sola-border-subtle, #e2e8f0);
    color: var(--sola-text-secondary, #64748b);
    padding: 2px 7px;
    border-radius: var(--sola-control-radius, 6px);
    font-family: ui-monospace, monospace;
  }

  .gauge-body { display: flex; align-items: center; justify-content: space-between; gap: 16px; }

  .gauge-value {
    font-size: 1.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--sola-text-primary, #0f172a);
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .gauge-subtext { font-size: 12px; color: var(--sola-text-secondary, #64748b); font-weight: 400; }

  .gauge-ring-wrap { position: relative; width: 64px; height: 64px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .gauge-ring { width: 100%; height: 100%; transform: rotate(-90deg); }
  .gauge-arc { transition: stroke-dashoffset 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .gauge-pct { position: absolute; font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; font-family: ui-monospace, monospace; color: var(--sola-text-primary, #0f172a); }

  .gauge-footer {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--sola-border-subtle, #f1f5f9);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-family: ui-monospace, monospace;
    color: var(--sola-text-tertiary, #64748b);
  }

  .gauge-footer-left { display: flex; align-items: center; gap: 6px; }
  .gauge-footer-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sola-color-primary-500, #10b981); }
  .gauge-footer-right { font-weight: 600; color: var(--sola-text-secondary, #64748b); }
</style>
