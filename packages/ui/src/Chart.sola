    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--sola-text-primary, #0f172a);
    margin-top: 4px;
  }
  .sola-delta-badge {
    background: var(--sola-alert-positive-bg, #ecfdf5);
    color: var(--sola-alert-positive-text, #047857);
    border: 1px solid var(--sola-border-subtle, rgba(16, 185, 129, 0.2));
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    padding: 2px 7px;
    border-radius: var(--sola-control-radius, 6px);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .sola-spark-bars {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 60px;
    padding-top: 6px;
  }
  .sola-bar {
    flex: 1;
    background: color-mix(in srgb, var(--sola-color-primary-500, #10b981) 32%, var(--sola-surface-2, #e2e8f0));
    border-radius: 3px 3px 0 0;
    transition: background 0.16s ease;
  }
  .sola-bar:hover {
    background: var(--sola-color-primary-500, #10b981);
  }
</style>
