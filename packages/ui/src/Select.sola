<script>
  export let label = "Select option";
  export let initialSelected = "";
  export let placeholder = "Choose an option...";
  export let name = "";
  export let disabled = false;
  export let required = false;
  // Array of { value, label } (or plain strings). Slot content still works for
  // callers that want to author <option> elements themselves; this is the path
  // for the far more common case of handing the component a list.
  export let options = [];
  export let onChange = null;
  export let id = "sola-select-" + Math.random().toString(36).slice(2, 9);

  let selected = $state(initialSelected);

  let items = $derived(() =>
    (options || []).map((o) =>
      o && typeof o === "object"
        ? { value: o.value, label: o.label === undefined ? o.value : o.label }
        : { value: o, label: o }
    )
  );

  function handleChange(e) {
    selected = e.target.value;
    if (typeof onChange === "function") onChange(e.target.value);
  }
</script>

<div class="sola-select-wrapper">
  {#if label}
    <label class="select-label" for={id}>{label}</label>
  {/if}
  <div class="select-field-wrap">
    <select
      class="select-native"
      id={id}
      name={name}
      disabled={disabled}
      required={required}
      value={selected}
      onchange={handleChange}
    >
      <!-- Each option carries `selected`: the select's value is set before the
           options below exist, so on its own it never matched one and the first
           option showed instead of initialSelected. -->
      <option value="" disabled selected={!selected}>{placeholder}</option>
      {#each items() as item}
        <option value={item.value} selected={item.value === selected}>{item.label}</option>
      {/each}
      <slot />
    </select>
    <div class="select-arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </div>
</div>

<style>
  .sola-select-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--sola-space-2, 6px);
    width: 100%;
  }

  .select-label {
    font-size: var(--sola-font-size-sm, 12px);
    font-weight: var(--sola-font-weight-semibold, 600);
    color: var(--sola-text-secondary, #475569);
    letter-spacing: 0.02em;
  }

  .select-field-wrap {
    position: relative;
    width: 100%;
  }

  .select-native {
    width: 100%;
    appearance: none;
    background: var(--sola-surface-1, rgba(248, 250, 252, 0.9));
    border: 1px solid var(--sola-border-default, rgba(203, 213, 225, 0.8));
    border-radius: var(--sola-radius-lg, 12px);
    padding: 12px 36px 12px 16px;
    font-size: var(--sola-font-size-md, 14px);
    font-weight: var(--sola-font-weight-medium, 500);
    color: var(--sola-text-primary, #0f172a);
    outline: none;
    cursor: pointer;
    transition: border-color var(--sola-duration-fast, 160ms) var(--sola-ease-standard, ease),
                box-shadow var(--sola-duration-fast, 160ms) var(--sola-ease-standard, ease);
  }

  .select-native:focus-visible {
    background: var(--sola-surface-0, #ffffff);
    border-color: var(--sola-color-primary-500, #10b981);
    box-shadow: var(--sola-focus-ring, 0 0 0 3px rgba(16, 185, 129, 0.4));
  }

  .select-native:disabled {
    color: var(--sola-text-tertiary, #94a3b8);
    cursor: not-allowed;
  }

  .select-arrow {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--sola-text-secondary, #64748b);
    display: flex;
    align-items: center;
  }
</style>
