<script>
  export let endpoint = '/api/intent';
  export let model = null;
  export let provider = null;
  export let placeholder = 'Ask anything…';
  export let systemLabel = 'AI';
  export let userLabel = 'You';
  export let onmessage = null;

  let messages = $state([]);
  let input = $state('');
  let streaming = $state(false);
  let streamBuffer = $state('');
  let abortController = null;
  let threadEl = null;
  const threadId = 'sola-thread-msgs-' + Math.random().toString(36).slice(2, 9);

  function scrollToBottom() {
    const el = threadEl || (typeof document !== 'undefined' ? document.getElementById(threadId) : null);
    if (el) el.scrollTop = el.scrollHeight;
  }

  async function send() {
    const text = input().trim();
    if (!text || streaming()) return;

    input = '';
    messages = [...messages(), { role: 'user', content: text }];
    streaming = true;
    streamBuffer = '';

    if (abortController) abortController.abort();
    abortController = new AbortController();

    const history = messages().map(m => ({ role: m.role, content: m.content }));

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: history,
          stream: true,
          ...(model ? { model } : {}),
          ...(provider ? { provider } : {})
        }),
        signal: abortController.signal
      });

      if (!res.ok) throw new Error(`Request failed: ${res.status}`);

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buf = '';
      let accumulated = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });

        const lines = buf.split('\n');
        buf = lines.pop();

        for (const line of lines) {
          if (!line.startsWith('data: ')) continue;
          const payload = line.slice(6).trim();
          if (payload === '[DONE]') break;
          try {
            const evt = JSON.parse(payload);
            const token = evt.token ?? evt.delta ?? evt.content ?? '';
            accumulated += token;
            streamBuffer = accumulated;
            scrollToBottom();
          } catch { /* skip */ }
        }
      }

      messages = [...messages(), { role: 'assistant', content: accumulated }];
    } catch (err) {
      if (err.name !== 'AbortError') {
        messages = [...messages(), { role: 'assistant', content: '⚠️ ' + err.message, error: true }];
      }
    } finally {
      streaming = false;
      streamBuffer = '';
      scrollToBottom();
      if (onmessage) onmessage(messages());
    }
  }

  function handleKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      send();
    }
  }
</script>

<div class="sola-thread">
  <div class="thread-messages" id={threadId} bind:this={threadEl}>
    {#each messages() as msg}
      <div class="msg msg--{msg.role} {msg.error ? 'msg--error' : ''}">
        <div class="msg-label">{msg.role === 'user' ? userLabel : systemLabel}</div>
        <div class="msg-content">{msg.content}</div>
      </div>
    {/each}

    {#if streaming()}
      <div class="msg msg--assistant msg--streaming">
        <div class="msg-label">{systemLabel}</div>
        <div class="msg-content">
          {streamBuffer()}
          <span class="cursor"></span>
        </div>
      </div>
    {/if}

    {#if !messages().length && !streaming()}
      <div class="empty-state">
        <div class="empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="9" stroke-dasharray="4 3"/>
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 2a10 10 0 0 1 10 10"/>
          </svg>
        </div>
        <p>{placeholder}</p>
      </div>
    {/if}
  </div>

  <div class="thread-input-row">
    <textarea
      class="thread-input"
      placeholder={placeholder}
      aria-label={placeholder}
      bind:value={input}
      onkeydown={handleKey}
      rows="1"
      disabled={streaming()}
    ></textarea>
    <button class="send-btn" aria-label="Send message" onclick={send} disabled={streaming()}>
      {#if streaming()}
        <svg class="spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
        </svg>
      {:else}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
        </svg>
      {/if}
    </button>
  </div>
</div>

<style>
  .sola-thread {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 320px;
    background: var(--sola-surface-0, #fff);
    border: 1px solid var(--sola-border-subtle, #e2e8f0);
    border-radius: 20px;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .thread-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-behavior: smooth;
  }

  .msg {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 85%;
  }

  .msg--user {
    align-self: flex-end;
    align-items: flex-end;
  }

  .msg--assistant {
    align-self: flex-start;
  }

  .msg-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sola-text-tertiary, #94a3b8);
    padding: 0 4px;
  }

  .msg-content {
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .msg--user .msg-content {
    background: var(--sola-color-primary-500, #10b981);
    color: var(--sola-color-neutral-0, #fff);
    border-radius: 16px 16px 4px 16px;
  }

  .msg--assistant .msg-content {
    background: var(--sola-surface-1, #f8fafc);
    color: var(--sola-text-primary, #0f172a);
    border: 1px solid var(--sola-border-subtle, #e2e8f0);
    border-radius: 16px 16px 16px 4px;
  }

  .msg--error .msg-content {
    background: var(--sola-alert-high-bg, #fef2f2);
    color: var(--sola-alert-high, #ef4444);
    border-color: var(--sola-border-subtle, #fecaca);
  }

  .msg--streaming .msg-content {
    background: var(--sola-alert-positive-bg, #f0fdf9);
    border-color: var(--sola-border-subtle, #a7f3d0);
  }

  .cursor {
    display: inline-block;
    width: 2px;
    height: 14px;
    background: var(--sola-color-primary-500, #10b981);
    vertical-align: middle;
    margin-left: 2px;
    animation: blink 0.7s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--sola-text-tertiary, #94a3b8);
    text-align: center;
    padding: 40px;
  }

  .empty-icon svg {
    width: 40px;
    height: 40px;
    color: var(--sola-color-neutral-300, #cbd5e1);
  }

  .empty-state p {
    font-size: 14px;
    margin: 0;
  }

  .thread-input-row {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--sola-surface-2, #f1f5f9);
    background: var(--sola-surface-1, #fafbfc);
    align-items: flex-end;
  }

  .thread-input {
    flex: 1;
    resize: none;
    border: 1px solid var(--sola-border-subtle, #e2e8f0);
    border-radius: 14px;
    padding: 10px 14px;
    font-size: 14px;
    font-family: inherit;
    line-height: 1.5;
    outline: none;
    background: var(--sola-surface-0, #fff);
    color: var(--sola-text-primary, #0f172a);
    transition: border-color 0.15s;
    max-height: 160px;
    overflow-y: auto;
  }

  .thread-input:focus {
    border-color: var(--sola-color-primary-500, #10b981);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
  }

  .thread-input:disabled {
    background: var(--sola-surface-1, #f8fafc);
    color: var(--sola-text-tertiary, #94a3b8);
  }

  .send-btn {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--sola-color-primary-500, #10b981);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sola-color-neutral-0, #fff);
    transition: background 0.15s, transform 0.1s;
    flex-shrink: 0;
  }

  .send-btn:hover:not(:disabled) { background: var(--sola-color-primary-600, #059669); transform: scale(1.05); }
  .send-btn:disabled { background: #cbd5e1; cursor: not-allowed; }

  .send-btn svg {
    width: 16px;
    height: 16px;
  }

  .spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
