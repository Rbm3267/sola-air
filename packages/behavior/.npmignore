# Ignore test suites and scratch scripts
tests/
__tests__/
*.test.*
*.spec.*
smoke_test.*

# Superseded by the plain-JS src/*.js this package now ships (see src/*.d.ts
# for the types) - kept in the working tree only until they're deleted.
src/*.ts

# Ignore environment & keys
.env
.env.*
*.local
secrets.*
credentials.*
*.pem
*.key

# Ignore local config & logs
.npmrc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.prettiercache
.tsbuildinfo

# Ignore IDE settings
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/
