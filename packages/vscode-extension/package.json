{
  "name": "sola-vscode",
  "displayName": "Sola AIR",
  "description": "Language support and file icons for Sola AIR (.sola) components",
  "version": "0.2.0",
  "publisher": "SolaAIR",
  "license": "MIT",
  "homepage": "https://sola-air.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rbm3267/sola-air",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/Rbm3267/sola-air/issues"
  },
  "keywords": [
    "sola",
    "sola-air",
    ".sola",
    "signals",
    "intent",
    "file icon"
  ],
  "icon": "icons/sola-128.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish:vscode": "vsce publish --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "sola",
        "aliases": [
          "Sola",
          "sola"
        ],
        "extensions": [
          ".sola"
        ],
        "icon": {
          "light": "./icons/sola-file.png",
          "dark": "./icons/sola-file.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sola",
        "scopeName": "text.html.sola",
        "path": "./syntaxes/sola.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.sola": "javascript",
          "source.js": "javascript",
          "source.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "sola",
        "path": "./snippets/sola.code-snippets"
      }
    ]
  }
}
