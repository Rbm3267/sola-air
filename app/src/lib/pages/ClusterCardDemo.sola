<script>
  import DataCard from '@sola-air-ui/ui/DataCard.sola';

  let rps = $state(1420);
  let util = $derived(Math.min(100, Math.round(rps / 20)));

  $on('sola:compiler-rps', (e) => {
    if (e && typeof e.rps === 'number') {
      rps = e.rps;
    }
  });
</script>

<div class="cluster-demo">
  <DataCard
    title="Cluster Throughput"
    value={`${rps} req/s`}
    trend={`${util}% capacity`}
  />
  <div class="meter-track" aria-hidden="true">
    <div class="meter-fill" style={`width: ${util}%`}></div>
  </div>
</div>

<style>
  .cluster-demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .meter-track {
    height: 10px;
    border-radius: 999px;
    background: var(--sola-surface-2, #e2e8f0);
    overflow: hidden;
  }
  .meter-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #38bdf8, #2563eb, #9333ea);
    transition: width 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>
