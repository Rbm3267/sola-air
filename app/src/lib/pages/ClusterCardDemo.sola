<script>
  // The homepage's Compiler X-Ray shows this file and the compiler's real output
  // for it, generated at build time. Keep the bindings direct ({updates}, {budget})
  // so what the X-Ray shows is a text-node update, not a child re-mount.
  let updates = $state(1420);
  let budget = $derived(Math.min(100, Math.round(updates / 20)));

  $on('sola:compiler-updates', (e) => {
    if (e && typeof e.updates === 'number') updates = e.updates;
  });
</script>

<div class="signal-card">
  <span class="label">Reactive DOM Writes</span>
  <span class="value">{updates} ops/s</span>
  <span class="trend">{budget}% frame budget</span>
  <div class="track" aria-hidden="true">
    <div class="fill" style="width: {budget}%"></div>
  </div>
</div>

<style>
  .signal-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: ui-sans-serif, system-ui, sans-serif;
  }
  .label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sola-text-secondary, #475569);
  }
  .value {
    font-size: 28px;
    font-weight: 800;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--sola-text-primary, #0f172a);
  }
  .trend {
    font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--sola-text-secondary, #475569);
  }
  .track {
    height: 10px;
    margin-top: 6px;
    border-radius: 999px;
    background: var(--sola-surface-2, #e2e8f0);
    overflow: hidden;
  }
  .fill {
    height: 100%;
    border-radius: 999px;
    background: var(--sola-accent, #1d4ed8);
    transition: width 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>
