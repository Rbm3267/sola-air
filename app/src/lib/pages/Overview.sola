<script>
  // The Written in Sola page. The route passes each tour example's source and
  // the compiler's real output for it (read at build time in vite.config.ts), so
  // the panes cannot drift from the components running beside them.
  import Counter from './tour/Counter.sola';
  import Tasks from './tour/Tasks.sola';
  import Incidents from './tour/Incidents.sola';

  export let tour = [];
  export let primitiveCount = 37;
  export let coreKb = 7.5;

  const STEPS = {
    Counter: {
      title: 'State that updates one text node',
      notes: [
        '`let count = $state(0)` declares a signal. `count += 1` compiles to a setter call.',
        '`{count}` and `{doubled}` each compile to one effect that writes one text node. A click re-runs those two effects and nothing else.',
        'There is no re-render and no diff. Open the compiled output to see the effects.'
      ]
    },
    Tasks: {
      title: 'Lists, inputs and conditions',
      notes: [
        '`bind:value` keeps the input and `draft` in sync in both directions.',
        '`{#each tasks as task (task.id)}` keeps one row per id. When a task changes, only its row is rebuilt.',
        '`{#if}` and `{:else}` swap the summary line when the count reaches zero.'
      ]
    },
    Incidents: {
      title: 'Real components from @sola-air-ui/ui',
      notes: [
        'Components are imported like any module and used as tags.',
        '`rows={rows}` passes the live signal, so the table updates in place. `value={String(openCount)}` is an expression, so the card re-mounts with the new value.',
        'These are the same components the catalog lists and Studio exports.'
      ]
    }
  };

  // Which pane each step shows: its .sola source or the compiled JavaScript.
  let views = $state({});

  function show(name, view) {
    views = { ...views, [name]: view };
  }

  // Inline `code` in the notes, without innerHTML: split on backticks.
  function parts(text) {
    return text.split('`').map((t, i) => ({ t, code: i % 2 === 1 }));
  }
</script>

<div class="sola-overview-root">
  <header class="hero">
    <p class="badge">Written in Sola</p>
    <h1>Sola compiles your components into plain DOM code</h1>
    <p class="lede">
      You write a <code>.sola</code> file: a script, some markup and scoped styles. The compiler turns it
      into a small JavaScript module that updates the page directly when your data changes. There is no
      virtual DOM and no framework running alongside it, only a {coreKb} kB runtime for signals.
    </p>
    <p class="lede">This page is a <code>.sola</code> component, and so are the three examples below.</p>
    <div class="ctas">
      <a href="#start" class="cta-primary">Start a project</a>
      <a href="/components" class="cta-secondary">Browse {primitiveCount} components</a>
    </div>
    <ul class="facts">
      <li><strong>{coreKb} kB</strong><span>runtime, gzipped</span></li>
      <li><strong>{primitiveCount}</strong><span>ready-made components</span></li>
      <li><strong>No virtual DOM</strong><span>signals write to the DOM</span></li>
      <li><strong>Any framework</strong><span>a component is a mount function</span></li>
    </ul>
  </header>

  {#each tour as step, i (step.name)}
    <section class="step" aria-labelledby="step-{step.name}">
      <div class="step-head">
        <span class="step-num">0{i + 1}</span>
        <h2 id="step-{step.name}">{STEPS[step.name].title}</h2>
      </div>
      <div class="step-body">
        <div class="code-panel">
          <div class="tabs" role="group" aria-label="View for {step.name}.sola">
            <button type="button" aria-pressed={views[step.name] !== 'compiled'} class={views[step.name] !== 'compiled' ? 'tab on' : 'tab'} onclick={() => show(step.name, 'source')}>{step.name}.sola</button>
            <button type="button" aria-pressed={views[step.name] === 'compiled'} class={views[step.name] === 'compiled' ? 'tab on' : 'tab'} onclick={() => show(step.name, 'compiled')}>Compiled JavaScript</button>
            <span class="lines">{(views[step.name] === 'compiled' ? step.compiled : step.source).split('\n').length} lines</span>
          </div>
          {#if views[step.name] === 'compiled'}
            <pre tabindex="0" aria-label="Compiled output of {step.name}.sola"><code>{step.compiled}</code></pre>
          {:else}
            <pre tabindex="0" aria-label="Source of {step.name}.sola"><code>{step.source}</code></pre>
          {/if}
        </div>
        <div class="side">
          <div class="result" aria-label="{step.name} running">
            <span class="result-label">Running</span>
            {#if step.name === 'Counter'}
              <Counter />
            {/if}
            {#if step.name === 'Tasks'}
              <Tasks />
            {/if}
            {#if step.name === 'Incidents'}
              <Incidents />
            {/if}
          </div>
          <ul class="notes">
            {#each STEPS[step.name].notes as note}
              <li>
                {#each parts(note) as p}
                  {#if p.code}
                    <code>{p.t}</code>
                  {:else}
                    <span>{p.t}</span>
                  {/if}
                {/each}
              </li>
            {/each}
          </ul>
        </div>
      </div>
    </section>
  {/each}

  <section class="start" id="start" aria-labelledby="start-title">
    <h2 id="start-title">Start a project</h2>
    <p class="lede">The scaffold gives you Vite, the compiler plugin and an <code>App.sola</code> with a working counter.</p>
    <pre tabindex="0" aria-label="Commands to start a project"><code>npm create sola@latest my-app
cd my-app
npm install
npm run dev</code></pre>
    <div class="links">
      <a href="/docs">Read the docs</a>
      <a href="/components">Browse components</a>
      <a href="/studio">Arrange components in Studio</a>
      <a href="https://marketplace.visualstudio.com/items?itemName=SolaAIR.sola-vscode" target="_blank" rel="noreferrer">VS Code extension</a>
      <a href="https://github.com/Rbm3267/sola-ui-skill" target="_blank" rel="noreferrer">Claude and Gemini skill</a>
    </div>
  </section>
</div>

<style>
  /* Themed through tokens so the page is legible on both grounds. The light
     values are the defaults; the dark blocks only redefine the tokens. An
     explicit data-theme wins; without one, the OS preference decides. */
  .sola-overview-root {
    --ov-ink: #0f172a;
    --ov-ink-2: #475569;
    --ov-surface: #ffffff;
    --ov-surface-2: #f8fafc;
    --ov-code-bg: #0b1120;
    --ov-code-ink: #e2e8f0;
    --ov-line: rgba(15, 23, 42, 0.1);
    --ov-accent: #1d4ed8;
    --ov-accent-soft: rgba(59, 130, 246, 0.1);
    --ov-accent-line: rgba(59, 130, 246, 0.3);
    --ov-on-accent: #ffffff;

    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 48px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--ov-ink);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .sola-overview-root {
      --ov-ink: #f8fafc;
      --ov-ink-2: #94a3b8;
      --ov-surface: rgba(15, 23, 42, 0.8);
      --ov-surface-2: rgba(255, 255, 255, 0.04);
      --ov-code-bg: #050814;
      --ov-line: rgba(255, 255, 255, 0.1);
      --ov-accent: #60a5fa;
      --ov-accent-soft: rgba(59, 130, 246, 0.12);
      --ov-accent-line: rgba(59, 130, 246, 0.3);
      --ov-on-accent: #090d19;
    }
  }
  :root[data-theme="dark"] .sola-overview-root {
    --ov-ink: #f8fafc;
    --ov-ink-2: #94a3b8;
    --ov-surface: rgba(15, 23, 42, 0.8);
    --ov-surface-2: rgba(255, 255, 255, 0.04);
    --ov-code-bg: #050814;
    --ov-line: rgba(255, 255, 255, 0.1);
    --ov-accent: #60a5fa;
    --ov-accent-soft: rgba(59, 130, 246, 0.12);
    --ov-accent-line: rgba(59, 130, 246, 0.3);
    --ov-on-accent: #090d19;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: var(--ov-surface-2);
    border: 1px solid var(--ov-line);
    padding: 1px 5px;
    border-radius: 5px;
  }

  .hero { max-width: 820px; margin: 0 auto 64px; text-align: center; }
  .badge {
    display: inline-flex; margin: 0 0 20px; padding: 4px 12px; border-radius: 9999px;
    background: var(--ov-accent-soft); border: 1px solid var(--ov-accent-line); color: var(--ov-accent);
    font: 700 12px ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  h1 { font-size: 44px; font-weight: 900; line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 16px; }
  @media (max-width: 640px) { h1 { font-size: 30px; } }
  .lede { font-size: 16px; line-height: 1.65; color: var(--ov-ink-2); margin: 0 auto 12px; max-width: 68ch; }
  .ctas { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin: 28px 0 32px; }
  .cta-primary, .cta-secondary {
    display: inline-flex; align-items: center; padding: 12px 22px; border-radius: 12px;
    font-weight: 700; font-size: 14px; text-decoration: none;
  }
  .cta-primary { background: var(--ov-accent); color: var(--ov-on-accent); }
  .cta-primary:hover { filter: brightness(1.08); }
  .cta-secondary { background: var(--ov-surface-2); border: 1px solid var(--ov-line); color: var(--ov-ink); }
  .cta-secondary:hover { border-color: var(--ov-accent-line); }
  .facts {
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
  }
  @media (max-width: 760px) { .facts { grid-template-columns: repeat(2, 1fr); } }
  .facts li {
    display: flex; flex-direction: column; gap: 2px; padding: 14px; border-radius: 14px;
    background: var(--ov-surface); border: 1px solid var(--ov-line);
  }
  .facts strong { font-size: 15px; font-weight: 800; }
  .facts span { font-size: 13px; color: var(--ov-ink-2); }

  .step { margin: 0 0 56px; }
  .step-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; }
  .step-num { font: 800 14px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ov-accent); }
  h2 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; margin: 0; }
  .step-body { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  @media (max-width: 900px) { .step-body { grid-template-columns: minmax(0, 1fr); } }

  .code-panel { border-radius: 16px; overflow: hidden; border: 1px solid var(--ov-line); background: var(--ov-code-bg); }
  .tabs { display: flex; align-items: center; gap: 4px; padding: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .tab {
    padding: 6px 10px; border-radius: 8px; border: 0; cursor: pointer; background: transparent;
    font: 600 12px ui-monospace, SFMono-Regular, Menlo, monospace; color: #94a3b8;
  }
  .tab:hover { color: #e2e8f0; }
  .tab.on { background: rgba(255, 255, 255, 0.1); color: #f8fafc; }
  .tab:focus-visible { outline: 2px solid #60a5fa; outline-offset: 1px; }
  .lines { margin-left: auto; font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; color: #94a3b8; padding-right: 6px; }
  pre {
    margin: 0; padding: 16px; max-height: 440px; overflow: auto;
    font: 12.5px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ov-code-ink); background: var(--ov-code-bg);
  }
  pre code { background: none; border: 0; padding: 0; font-size: inherit; color: inherit; }
  pre:focus-visible { outline: 2px solid #60a5fa; outline-offset: -2px; }

  .side { display: flex; flex-direction: column; gap: 16px; }
  .result {
    /* Grid, not flex: a mounted child sits in a wrapper element, and a centred
       flex item would shrink that wrapper to its content. */
    position: relative; display: grid; align-items: center; min-height: 200px;
    padding: 36px 20px 24px; border-radius: 16px; background: var(--ov-surface); border: 1px solid var(--ov-line);
  }
  .result-label {
    position: absolute; top: 12px; left: 14px;
    font: 700 12px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ov-ink-2);
  }
  .notes { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px; }
  .notes li { font-size: 14px; line-height: 1.6; color: var(--ov-ink-2); }

  .start {
    padding: 28px; border-radius: 20px; background: var(--ov-surface); border: 1px solid var(--ov-line);
  }
  .start h2 { margin-bottom: 8px; }
  .start .lede { margin: 0 0 16px; text-align: left; max-width: none; }
  .start pre { border-radius: 12px; max-width: 520px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 18px; }
  .links a { font-weight: 700; font-size: 14px; color: var(--ov-accent); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
</style>
