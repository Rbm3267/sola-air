  </div>

  <!-- Live proof: a real signal, updating a real text node -->
  <div class="proof-card">
    <div class="proof-label">Live signal</div>
    <div class="proof-value">{signalTick}</div>
    <div class="proof-meta">{ticks} updates · one text node mutated per click</div>
    <button class="proof-btn" onclick={triggerTick}>Emit signal</button>
  </div>

  <!-- Grid Pillars -->
  <div class="pillars-grid">
    <div class="pillar-card">
      <div class="pillar-icon">01</div>
      <h3 class="pillar-title">Zero-VDOM signals</h3>
      <p class="pillar-desc">A signal write reaches the text node or attribute it owns directly. There is no diff pass and no reconciler in between.</p>
    </div>

    <div class="pillar-card">
      <div class="pillar-icon">02</div>
      <h3 class="pillar-title">Tactile controls</h3>
      <p class="pillar-desc">Rotary dials, range sliders, and rolling counters driven by drag and wheel input with eased, momentum-style motion.</p>
    </div>

    <div class="pillar-card">
      <div class="pillar-icon">03</div>
      <h3 class="pillar-title">Compiles to plain DOM</h3>
      <p class="pillar-desc">One signal core, compiled from <code>.sola</code> single-file components into ordinary DOM calls you can read.</p>
    </div>
  </div>
</div>

