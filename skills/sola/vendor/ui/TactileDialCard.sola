<script>
  export let title = "Rotary Touch Controller";
  export let metric = ""; // formatted center readout; falls back to "<currentValue>" if unset
  export let unit = "Drag to adjust";
  export let min = 0;
  export let max = 100;
  export let currentValue = 48;
  export let color = "amber"; // amber | emerald | sky
  export let onChange = null;

  let dialValue = $state(currentValue);
  let isDragging = $state(false);

  const colorMap = {
    amber:   { from: "#f59e0b", to: "#ea580c" },
    emerald: { from: "#10b981", to: "#059669" },
    sky:     { from: "#0ea5e9", to: "#0284c7" },
  };
  let activeColor = $derived(() => colorMap[color] || colorMap.amber);
  let pct = $derived(() => {
    var span = max - min;
    if (!span) return 0;
    return Math.min(Math.max(((dialValue() - min) / span) * 100, 0), 100);
  });
  let dashOffset = $derived(() => 251.2 * (1 - pct() / 100));
  let displayText = $derived(() => metric || String(dialValue()));

  function setDialValue(next) {
    var clamped = Math.min(Math.max(Math.round(next), min), max);
    dialValue = clamped;
    if (typeof onChange === "function") onChange(clamped);
  }

  function angleToValue(clientX, clientY, rect) {
    var centerX = rect.left + rect.width / 2;
    var centerY = rect.top + rect.height / 2;
    var dx = clientX - centerX;
    var dy = clientY - centerY;
    var angle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
    if (angle < 0) angle += 360;
    var raw = min + (angle / 360) * (max - min);
    return Math.min(Math.max(Math.round(raw), min), max);
  }

  function handleMouseMove(e) {
    if (!isDragging()) return;
    setDialValue(angleToValue(e.clientX, e.clientY, e.currentTarget.getBoundingClientRect()));
  }
  function handleTouchMove(e) {
    if (!isDragging()) return;
    var t = e.touches[0];
    setDialValue(angleToValue(t.clientX, t.clientY, e.currentTarget.getBoundingClientRect()));
  }
  function startMouse(e) {
    isDragging = true;
    setDialValue(angleToValue(e.clientX, e.clientY, e.currentTarget.getBoundingClientRect()));
  }
  function startTouch(e) {
    isDragging = true;
    var t = e.touches[0];
    setDialValue(angleToValue(t.clientX, t.clientY, e.currentTarget.getBoundingClientRect()));
  }
  function stopDrag() {
    isDragging = false;
  }
  function handleKeyDown(e) {
    if (e.key === "ArrowRight" || e.key === "ArrowUp") {
      e.preventDefault();
      setDialValue(dialValue() + 1);
    } else if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
      e.preventDefault();
      setDialValue(dialValue() - 1);
    } else if (e.key === "Home") {
      e.preventDefault();
      setDialValue(min);
    } else if (e.key === "End") {
      e.preventDefault();
      setDialValue(max);
    }
  }
  function handleWheel(e) {
    e.preventDefault();
    var delta = e.deltaY < 0 ? 1 : -1;
    setDialValue(dialValue() + delta);
  }
</script>

<div class="sola-dial-card sola-dial-{color}">
  <div class="dial-header">
    <div class="dial-header-left">
      <span class="dial-status-dot"></span>
      <h3 class="dial-title">{title}</h3>
    </div>
    <span class="dial-badge">1-Thumb Rotary</span>
  </div>

  <div
    class="dial-touch-area"
    role="slider"
    tabindex="0"
    aria-label={title}
    aria-valuemin={min}
    aria-valuemax={max}
    aria-valuenow={dialValue()}
    onmousedown={startMouse}
    onmousemove={handleMouseMove}
    onmouseup={stopDrag}
    onmouseleave={stopDrag}
    ontouchstart={startTouch}
    ontouchmove={handleTouchMove}
    ontouchend={stopDrag}
    onkeydown={handleKeyDown}
    onwheel={handleWheel}
  >
    <svg class="dial-svg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
      <circle cx="50" cy="50" r="40" stroke="var(--sola-surface-2, #f1f5f9)" stroke-width="8" fill="none" />
      <circle
        class="dial-arc"
        cx="50" cy="50" r="40"
        stroke={activeColor().from}
        stroke-width="8"
        stroke-dasharray="251.2"
        stroke-dashoffset={dashOffset()}
        stroke-linecap="round"
        fill="none"
      />
    </svg>
    <div class="dial-center">
      <span class="dial-value">{displayText()}</span>
      <span class="dial-hint">{unit}</span>
    </div>
  </div>

  <p class="dial-subtext">Range {min}–{max} &middot; drag or tap the ring to set</p>
</div>

<style>
  .sola-dial-card {
    position: relative;
    background: var(--sola-surface-0, #ffffff);
    border: 1px solid var(--sola-border-subtle, rgba(226, 232, 240, 0.9));
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    transition: box-shadow var(--sola-duration-base, 240ms) var(--sola-ease-standard, cubic-bezier(0.16, 1, 0.3, 1));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .sola-dial-card:hover { box-shadow: 0 8px 24px -8px rgba(0,0,0,0.08); }

  .dial-header { width: 100%; display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .dial-header-left { display: flex; align-items: center; gap: 8px; }
  .dial-status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dial-dot, #f59e0b); }
  .sola-dial-amber   { --dial-dot: #f59e0b; }
  .sola-dial-emerald { --dial-dot: #10b981; }
  .sola-dial-sky     { --dial-dot: #0ea5e9; }

  .dial-title { font-size: 12px; font-family: ui-monospace, monospace; font-weight: 900; color: var(--sola-text-primary, #0f172a); text-transform: uppercase; letter-spacing: 0.06em; margin: 0; }

  .dial-badge {
    font-size: 12px;
    font-family: ui-monospace, monospace;
    font-weight: 600;
    background: var(--sola-alert-warning-bg, #fffbeb);
    color: var(--sola-alert-warning, #b45309);
    border: 1px solid var(--sola-border-subtle, #fde68a);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .dial-touch-area {
    position: relative;
    width: 176px;
    height: 176px;
    flex-shrink: 0;
    margin: 8px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    user-select: none;
    touch-action: none;
    border-radius: 50%;
  }

  .dial-touch-area:focus-visible {
    outline: 2px solid var(--sola-color-primary-500, #10b981);
    outline-offset: 4px;
  }

  .dial-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .dial-arc { transition: stroke-dashoffset 75ms linear; }

  .dial-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; }
  .dial-value { font-size: 26px; font-weight: 900; color: var(--sola-text-primary, #020617); font-family: ui-monospace, monospace; letter-spacing: -0.02em; }
  .dial-hint { font-size: 12px; font-family: ui-monospace, monospace; color: var(--sola-text-secondary, #64748b); margin-top: 2px; }

  .dial-subtext { font-size: 12px; color: var(--sola-text-secondary, #64748b); margin-top: 8px; font-family: ui-monospace, monospace; }
</style>
