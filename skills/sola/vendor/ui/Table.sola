<script>
  // Both columns and rows accept either a plain array or a getter function
  // (const rows = () => signal()), matching StreamView/IntentCard/Modal's convention.
  //
  // A column is a string (the row key) or an object:
  //   { key, label, rowHeader?: true, render?: (row, i) => string | { text, tone } }
  // rowHeader renders that cell as <th scope="row">. render returns the cell text,
  // or a pill: { text, tone: 'ok' | 'warn' | 'neutral' }.
  export let columns = [];
  export let rows = [];
  export let caption = "";
  // Hide the caption visually but keep it for screen readers.
  export let captionHidden = false;
  export let striped = false;
  export let onRowClick = null;
  export let dark = false;

  const read = (v) => (typeof v === 'function' ? v() : v);

  let resolvedRows = $derived(() => read(rows) || []);
  let resolvedColumns = $derived(() => {
    const c = read(columns);
    if (Array.isArray(c) && c.length > 0) return c;
    const r = resolvedRows();
    if (Array.isArray(r) && r.length > 0 && r[0] && typeof r[0] === 'object') {
      return Object.keys(r[0]);
    }
    return [];
  });
  let captionText = $derived(() => read(caption) || '');

  const TONES = ['ok', 'warn', 'neutral'];

  function columnKey(col) {
    return typeof col === 'string' ? col : col.key;
  }

  function columnLabel(col) {
    return typeof col === 'string' ? col : (col.label ?? col.key ?? '');
  }

  // Normalise a cell to { text, tone }; tone is '' for plain text.
  function cellOf(row, col, i) {
    let out = typeof col === 'object' && col && typeof col.render === 'function'
      ? col.render(row, i)
      : row == null ? '' : row[columnKey(col)];
    if (out && typeof out === 'object') {
      const tone = TONES.includes(out.tone) ? out.tone : 'neutral';
      return { text: out.text == null ? '' : String(out.text), tone };
    }
    return { text: out == null ? '' : String(out), tone: '' };
  }

  function isRowHeader(col) {
    return typeof col === 'object' && col !== null && col.rowHeader === true;
  }

  function handleRowClick(row, i) {
    if (typeof onRowClick === 'function') {
      onRowClick(row, i);
    }
  }
</script>

<div class="table-wrapper {dark ? 'dark' : ''} {striped ? 'striped' : ''}">
  <table>
    {#if captionText()}
      <caption class={captionHidden ? 'visually-hidden' : ''}>{captionText()}</caption>
    {/if}
    <thead>
      <tr>
        {#each resolvedColumns() as col}
          <th scope="col">{columnLabel(col)}</th>
        {/each}
      </tr>
    </thead>
    <tbody>
      {#each resolvedRows() as row, i}
        <tr class="{typeof onRowClick === 'function' ? 'clickable' : ''}" tabindex={typeof onRowClick === 'function' ? '0' : '-1'} onclick={() => handleRowClick(row, i)} onkeydown={(e) => { if ((e.key === 'Enter' || e.key === ' ') && typeof onRowClick === 'function') { e.preventDefault(); handleRowClick(row, i); } }}>
          {#each resolvedColumns() as col}
            {#if isRowHeader(col)}
              <th scope="row" class="row-header">
                {#if cellOf(row, col, i).tone}
                  <span class="pill pill-{cellOf(row, col, i).tone}">{cellOf(row, col, i).text}</span>
                {:else}
                  {cellOf(row, col, i).text}
                {/if}
              </th>
            {:else}
              <td>
                {#if cellOf(row, col, i).tone}
                  <span class="pill pill-{cellOf(row, col, i).tone}">{cellOf(row, col, i).text}</span>
                {:else}
                  {cellOf(row, col, i).text}
                {/if}
              </td>
            {/if}
          {/each}
        </tr>
      {/each}
    </tbody>
  </table>
</div>

<style>
  .table-wrapper {
    overflow-x: auto;
    background: var(--sola-surface-0, #ffffff);
    border: 1px solid var(--sola-border-subtle, #e2e8f0);
    border-radius: var(--sola-card-radius, 12px);
    box-shadow: var(--sola-card-shadow, none);
    transition: border-color 0.2s ease;
  }

  .table-wrapper.dark { border-color: rgba(255, 255, 255, 0.08); }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  th {
    text-align: left;
    padding: var(--sola-table-cell-padding, 10px 14px);
    font-size: 12px;
    font-weight: 600;
    color: var(--sola-text-secondary, #475569);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--sola-surface-1, #f8fafc);
    border-bottom: 1px solid var(--sola-border-subtle, #e2e8f0);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .table-wrapper.dark th {
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.02);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }

  td {
    padding: var(--sola-table-cell-padding, 10px 14px);
    color: var(--sola-text-primary, #334155);
    border-bottom: 1px solid var(--sola-border-subtle, #f1f5f9);
  }

  .table-wrapper.striped tbody tr:nth-child(even) td {
    background: var(--sola-surface-1, #f8fafc);
  }

  .table-wrapper.dark td {
    color: #c3cbdc;
    border-bottom-color: rgba(255, 255, 255, 0.06);
    background: transparent;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tr:hover td {
    background: var(--sola-surface-1, #f8fafc);
  }

  .table-wrapper.dark tr:hover td {
    background: rgba(255, 255, 255, 0.03);
  }

  tr.clickable {
    cursor: pointer;
  }

  caption {
    caption-side: top;
    text-align: left;
    padding: var(--sola-table-cell-padding, 10px 14px);
    font-size: 13px;
    font-weight: 600;
    color: var(--sola-text-primary, #0f172a);
  }

  caption.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Row headers read like body cells, not like the uppercase column headers. */
  tbody th.row-header {
    text-transform: none;
    letter-spacing: normal;
    font-size: 13px;
    font-family: inherit;
    font-weight: 600;
    color: var(--sola-text-primary, #0f172a);
    background: transparent;
    border-bottom: 1px solid var(--sola-border-subtle, #f1f5f9);
  }

  .table-wrapper.dark tbody th.row-header {
    color: #e2e8f0;
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }

  tr:last-child th.row-header {
    border-bottom: none;
  }

  .pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--sola-radius-full, 999px);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .pill-ok {
    color: var(--sola-alert-positive-text, #047857);
    background: var(--sola-alert-positive-bg, #ecfdf5);
    border-color: var(--sola-alert-positive-border, #a7f3d0);
  }

  .pill-warn {
    color: var(--sola-alert-warning, #b45309);
    background: var(--sola-alert-warning-bg, #fffbeb);
    border-color: var(--sola-alert-warning-border, #fde68a);
  }

  .pill-neutral {
    color: var(--sola-text-secondary, #475569);
    background: var(--sola-surface-1, #f8fafc);
    border-color: var(--sola-border-subtle, #e2e8f0);
  }
</style>
