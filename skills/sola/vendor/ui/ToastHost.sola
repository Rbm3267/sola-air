<script>
  export let listen = "sola:toast";
  export let duration = 5000;
  export let max = 4;
  export let onDismiss = null;

  let toasts = $state([]);
  let nextId = 1;
  const timers = {};

  function dismiss(id) {
    if (timers[id]) {
      clearTimeout(timers[id]);
      delete timers[id];
    }
    const gone = toasts().find((t) => t.id === id);
    if (!gone) return;
    toasts = toasts().filter((t) => t.id !== id);
    if (typeof onDismiss === "function") onDismiss(gone);
  }

  function show(payload) {
    if (!payload || typeof payload.text !== "string" || !payload.text) return;
    const toast = { id: nextId++, kind: payload.kind || "info", text: payload.text };
    const next = toasts().concat([toast]);
    // The oldest toasts leave first when the stack is full.
    const overflow = next.length - max;
    if (overflow > 0) {
      next.slice(0, overflow).forEach((t) => {
        if (timers[t.id]) {
          clearTimeout(timers[t.id]);
          delete timers[t.id];
        }
      });
    }
    toasts = overflow > 0 ? next.slice(overflow) : next;
    const ms = typeof payload.duration === "number" ? payload.duration : duration;
    if (ms > 0) timers[toast.id] = setTimeout(() => dismiss(toast.id), ms);
  }

  if (listen) {
    $on(listen, show);
  }

  onDestroy(() => {
    Object.keys(timers).forEach((id) => clearTimeout(timers[id]));
  });
</script>

<div class="sola-toast-host" role="region" aria-label="Notifications" aria-live="polite">
  {#each toasts() as toast (toast.id)}
    <div class="host-toast {toast.kind}" role={toast.kind === "error" ? "alert" : "status"}>
      <div class="host-toast-indicator" aria-hidden="true"></div>
      <div class="host-toast-text">{toast.text}</div>
      <button class="host-toast-close" type="button" on:click={() => dismiss(toast.id)} aria-label="Dismiss notification">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  {/each}
</div>

<style>
  .sola-toast-host {
    position: fixed;
    right: var(--sola-space-xl, 24px);
    bottom: var(--sola-space-xl, 24px);
    z-index: var(--sola-z-toast, 1000);
    display: flex;
    flex-direction: column;
    gap: var(--sola-space-sm, 8px);
    width: min(360px, calc(100vw - 32px));
    pointer-events: none;
  }

  .host-toast {
    display: flex;
    align-items: center;
    gap: var(--sola-space-md, 12px);
    padding: var(--sola-space-md, 12px) var(--sola-space-lg, 16px);
    background: var(--sola-color-neutral-900, #0f172a);
    color: var(--sola-color-neutral-0, #ffffff);
    border-radius: var(--sola-radius-lg, 16px);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.3);
    font-size: var(--sola-font-size-md, 14px);
    pointer-events: auto;
  }

  .host-toast-indicator {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: var(--sola-radius-full, 999px);
    background: var(--sola-color-neutral-400, #94a3b8);
  }

  .host-toast.success .host-toast-indicator {
    background: var(--sola-color-primary-400, #34d399);
  }

  .host-toast.error .host-toast-indicator {
    background: var(--sola-alert-critical, #ef4444);
  }

  .host-toast-text {
    flex: 1;
  }

  .host-toast-close {
    display: inline-flex;
    padding: var(--sola-space-xxs, 4px);
    border: 0;
    border-radius: var(--sola-radius-sm, 6px);
    background: transparent;
    color: inherit;
    opacity: 0.75;
    cursor: pointer;
  }

  .host-toast-close:hover {
    opacity: 1;
  }

  .host-toast-close:focus-visible {
    outline: 2px solid var(--sola-color-neutral-0, #ffffff);
    outline-offset: 2px;
    opacity: 1;
  }
</style>
