<script>
  // Accepts a plain boolean or a getter (() => signal()), so the sheet works
  // both self-contained and parent-controlled. It used to be read as `open()`
  // and written as `open(false)` — a prop can be neither, so closing threw.
  export let open = false;
  export let title = 'AI Response';
  export let intent = null;        // $intent signal or plain value
  export let actions = [];
  export let onclose = null;
  export let onaction = null;
  export let side = 'right';       // 'right' | 'bottom'

  let isOpen = $state(typeof open === 'function' ? open() : Boolean(open));

  createEffect(() => {
    if (typeof open === 'function') {
      isOpen = Boolean(open());
    }
  });

  const uid = Math.random().toString(36).slice(2, 9);
  const titleId = 'sola-sheet-title-' + uid;
  const sheetId = 'sola-sheet-' + uid;

  let returnFocusTo = null;

  const FOCUSABLE = 'a[href],button:not([disabled]),textarea:not([disabled]),input:not([disabled]),select:not([disabled]),[tabindex]:not([tabindex="-1"])';

  function sheetElement() {
    return typeof document === 'undefined' ? null : document.getElementById(sheetId);
  }

  function focusableItems() {
    const el = sheetElement();
    return el ? Array.from(el.querySelectorAll(FOCUSABLE)) : [];
  }

  function handleKeydown(e) {
    if (!isOpen()) return;

    if (e.key === 'Escape') {
      e.stopPropagation();
      close();
      return;
    }

    if (e.key !== 'Tab') return;
    const items = focusableItems();
    if (items.length === 0) { e.preventDefault(); return; }
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  createEffect(() => {
    if (typeof document === 'undefined') return;
    if (isOpen()) {
      returnFocusTo = document.activeElement;
      document.addEventListener('keydown', handleKeydown, true);
      queueMicrotask(() => {
        const items = focusableItems();
        (items[0] || sheetElement())?.focus?.();
      });
    } else {
      document.removeEventListener('keydown', handleKeydown, true);
      if (returnFocusTo && typeof returnFocusTo.focus === 'function') {
        returnFocusTo.focus();
        returnFocusTo = null;
      }
    }
  });

  onDestroy(() => {
    if (typeof document !== 'undefined') {
      document.removeEventListener('keydown', handleKeydown, true);
    }
  });

  let resolved = $derived(() => {
    if (!intent) return null;
    const val = typeof intent === 'function' ? intent() : intent;
    if (!val || val === 'Resolving...') return null;
    return val;
  });

  let isLoading = $derived(() => {
    if (!intent) return false;
    if (typeof intent?.loading === 'function') return intent.loading();
    const val = typeof intent === 'function' ? intent() : intent;
    return !val || val === 'Resolving...';
  });

  function close() {
    isOpen = false;
    if (onclose) onclose();
  }

  function handleAction(action) {
    if (onaction) onaction(action);
    if (action.onclick) action.onclick();
  }

  function handleBackdrop(e) {
    if (e.target === e.currentTarget) close();
  }
</script>

{#if isOpen()}
  <div class="sola-sheet-backdrop" onclick={handleBackdrop}>
    <div
      class="sola-sheet side-{side}"
      id={sheetId}
      role="dialog"
      aria-modal="true"
      aria-labelledby={titleId}
      tabindex="-1"
    >
      <!-- Header -->
      <div class="sheet-header">
        <div class="header-left">
          <div class="ai-dot" aria-hidden="true"></div>
          <h2 class="sheet-title" id={titleId}>{title}</h2>
        </div>
        <button class="close-btn" type="button" onclick={close} aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Body -->
      <div class="sheet-body">
        {#if isLoading()}
          <div class="sheet-loading" role="status" aria-live="polite" aria-label="Resolving response">
            <div class="shimmer" aria-hidden="true"></div>
            <div class="shimmer short" aria-hidden="true"></div>
            <div class="shimmer" aria-hidden="true"></div>
            <div class="shimmer xshort" aria-hidden="true"></div>
          </div>
        {:else if resolved()}
          <div class="sheet-content">
            {#if typeof resolved() === 'string'}
              <p class="prose">{resolved()}</p>
            {:else if resolved().title}
              <h3 class="content-title">{resolved().title}</h3>
              {#if resolved().body}
                <p class="prose">{resolved().body}</p>
              {/if}
              {#if resolved().items}
                <ul class="content-list">
                  {#each resolved().items as item}
                    <li>{item}</li>
                  {/each}
                </ul>
              {/if}
            {:else}
              <pre class="json-view">{JSON.stringify(resolved(), null, 2)}</pre>
            {/if}
          </div>
        {:else}
          <div class="sheet-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="9" stroke-dasharray="4 3"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <p>Waiting for intent…</p>
          </div>
        {/if}
      </div>

      <!-- Footer actions -->
      {#if actions.length}
        <div class="sheet-footer">
          {#each actions as action}
            <button
              class="footer-btn {action.variant || 'default'}"
              onclick={() => handleAction(action)}
              disabled={action.disabled}
            >
              {action.label}
            </button>
          {/each}
        </div>
      {/if}
    </div>
  </div>
{/if}

<style>
  .sola-sheet-backdrop {
    position: fixed;
    inset: 0;
    background: var(--sola-surface-overlay, rgba(15, 23, 42, 0.4));
    backdrop-filter: blur(4px);
    /* Was a bare 9999 — Modal.sola independently hardcoded 999. Both now come
       from the shared scale in @sola-air-ui/tokens instead of two components
       inventing their own numbers. */
    z-index: var(--sola-z-sheet, 900);
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
  }

  .sola-sheet {
    background: var(--sola-surface-0, #fff);
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 40px rgba(0,0,0,0.12);
    animation: slideIn var(--sola-duration-base, 240ms) var(--sola-ease-standard, cubic-bezier(0.16, 1, 0.3, 1));
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .side-right {
    width: min(480px, 95vw);
    height: 100%;
    border-radius: 20px 0 0 20px;
  }

  .side-bottom {
    width: 100%;
    max-height: 70vh;
    border-radius: 20px 20px 0 0;
    align-self: flex-end;
    box-shadow: 0 -8px 40px rgba(0,0,0,0.12);
    animation: slideUp var(--sola-duration-base, 240ms) var(--sola-ease-standard, cubic-bezier(0.16, 1, 0.3, 1));
  }

  @keyframes slideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  .sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--sola-border-subtle, #f1f5f9);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sola-alert-positive, #10b981);
    box-shadow: 0 0 6px var(--sola-alert-positive, #10b981);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .sheet-title {
    font-size: var(--sola-font-size-lg, 15px);
    font-weight: var(--sola-font-weight-bold, 700);
    color: var(--sola-text-primary, #0f172a);
    margin: 0;
  }

  .close-btn {
    width: 32px;
    height: 32px;
    border-radius: var(--sola-radius-md, 10px);
    border: none;
    background: var(--sola-surface-1, #f1f5f9);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sola-text-secondary, #64748b);
    transition: background var(--sola-duration-fast, 160ms) var(--sola-ease-standard, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .close-btn:hover { background: var(--sola-surface-2, #e2e8f0); color: var(--sola-text-primary, #0f172a); }
  .close-btn:focus-visible,
  .sola-sheet:focus-visible { outline: none; box-shadow: var(--sola-focus-ring, 0 0 0 3px rgba(16, 185, 129, 0.4)); }
  .close-btn svg { width: 14px; height: 14px; }

  .sheet-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .sheet-loading {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shimmer {
    height: 14px;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--sola-surface-1, #f1f5f9) 25%, var(--sola-surface-2, #e2e8f0) 50%, var(--sola-surface-1, #f1f5f9) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }
  .shimmer.short { width: 70%; }
  .shimmer.xshort { width: 40%; }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .sheet-content { display: flex; flex-direction: column; gap: 12px; }

  .content-title {
    font-size: var(--sola-font-size-xl, 18px);
    font-weight: var(--sola-font-weight-bold, 700);
    color: var(--sola-text-primary, #0f172a);
    margin: 0;
  }

  .prose {
    font-size: var(--sola-font-size-md, 14px);
    line-height: var(--sola-leading-relaxed, 1.7);
    color: var(--sola-text-primary, #334155);
    margin: 0;
    white-space: pre-wrap;
  }

  .content-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .content-list li { font-size: var(--sola-font-size-md, 14px); color: var(--sola-text-primary, #334155); line-height: var(--sola-leading-normal, 1.5); }

  .json-view {
    font-size: 12px;
    background: var(--sola-surface-1, #f8fafc);
    border: 1px solid var(--sola-border-default, #e2e8f0);
    border-radius: var(--sola-radius-md, 10px);
    padding: 14px;
    overflow-x: auto;
    color: var(--sola-text-secondary, #475569);
    font-family: ui-monospace, monospace;
  }

  .sheet-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--sola-text-tertiary, #94a3b8);
    padding: 40px 0;
  }
  .sheet-empty svg { width: 40px; height: 40px; }
  .sheet-empty p { font-size: 14px; margin: 0; }

  .sheet-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--sola-border-subtle, #f1f5f9);
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }

  .footer-btn {
    padding: 9px 18px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    font-family: inherit;
    transition: background var(--sola-duration-fast, 160ms) var(--sola-ease-standard, cubic-bezier(0.16, 1, 0.3, 1)), border-color var(--sola-duration-fast, 160ms) var(--sola-ease-standard, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .footer-btn.default {
    background: var(--sola-surface-1, #f1f5f9);
    color: var(--sola-text-primary, #334155);
    border-color: var(--sola-border-default, #e2e8f0);
  }
  .footer-btn.default:hover { background: var(--sola-surface-2, #e2e8f0); }

  .footer-btn.primary {
    background: var(--sola-color-primary-500, #10b981);
    color: var(--sola-color-neutral-0, #fff);
  }
  .footer-btn.primary:hover { background: var(--sola-color-primary-600, #059669); }
  .footer-btn:focus-visible { outline: none; box-shadow: var(--sola-focus-ring, 0 0 0 3px rgba(16, 185, 129, 0.4)); }

  .footer-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  @media (prefers-reduced-motion: reduce) {
    .sola-sheet, .side-bottom, .ai-dot, .shimmer { animation: none; }
  }
</style>
